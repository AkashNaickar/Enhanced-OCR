# Copy this file to `.env` and fill in real values. `.env` is gitignored.
#
# Path to the Google Cloud service-account JSON key used by the Vision API.
# Create one in the GCP console: IAM & Admin -> Service Accounts -> Keys ->
# Add key -> Create new key -> JSON. Export it as `vision_ocr.json` in the
# repo root (also gitignored) or point this at any path outside the repo.
GOOGLE_APPLICATION_CREDENTIALS=vision_ocr.json

# Optional alternative name for the same path. Only used when
# GOOGLE_APPLICATION_CREDENTIALS is unset.
# VISION_SERVICE_ACCOUNT_FILE=vision_ocr.json
